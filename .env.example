# ── Backend ──────────────────────────────────────────────────────────────────
# Copy to backend/.env

# PostgreSQL (Supabase)
# Pooler (port 6543). connection_limit caps Prisma's per-instance pool so we
# don't exhaust the shared pgbouncer transaction pool under load.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
# Direct connection (port 5432) — used by `prisma migrate` only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Stripe
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Webhook secret: after creating a webhook endpoint in Dashboard → Developers → Webhooks,
# copy the "Signing secret" (starts with whsec_). For local dev use `stripe listen`
# via the Stripe CLI, which prints a whsec_ to paste here.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="pln"
STRIPE_SUCCESS_URL="http://localhost:4200/checkout/success"
STRIPE_CANCEL_URL="http://localhost:4200/checkout/failure"

# InPost ShipX
INPOST_API_TOKEN=""
INPOST_ORGANIZATION_ID=""
INPOST_SANDBOX=true

# DHL
DHL_API_KEY=""
DHL_API_SECRET=""
DHL_ACCOUNT_NUMBER=""
DHL_SANDBOX=true

# GLS
GLS_USERNAME=""
GLS_PASSWORD=""
GLS_SENDER_ID=""
GLS_SANDBOX=true

# Resend (email)
RESEND_API_KEY=""
EMAIL_FROM="sklep@twojadomena.pl"

# Supabase Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# AdminJS
ADMIN_COOKIE_SECRET="change-me-admin-cookie-secret"
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="change-me-admin-password"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:4200"

# Sentry (optional — leave empty to disable error monitoring)
SENTRY_DSN=""
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Frontend ──────────────────────────────────────────────────────────────────
# Copy to frontend/.env

API_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""

# Sentry (frontend) — set in frontend/src/environments/environment.*.ts
# SENTRY_DSN_FRONTEND=""
