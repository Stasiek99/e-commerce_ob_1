# ── Backend ──────────────────────────────────────────────────────────────────
# Copy to backend/.env

# PostgreSQL (Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Przelewy24
P24_MERCHANT_ID=""
P24_POS_ID=""
P24_CRC=""
P24_API_KEY=""
P24_SANDBOX=true
P24_NOTIFY_URL="http://localhost:3000/payments/webhook"
P24_RETURN_URL="http://localhost:4200/checkout/success"
P24_CANCEL_URL="http://localhost:4200/checkout/failure"

# InPost ShipX
INPOST_API_TOKEN=""
INPOST_ORGANIZATION_ID=""
INPOST_SANDBOX=true

# DHL
DHL_API_KEY=""
DHL_API_SECRET=""
DHL_ACCOUNT_NUMBER=""
DHL_SANDBOX=true

# GLS
GLS_USERNAME=""
GLS_PASSWORD=""
GLS_SENDER_ID=""
GLS_SANDBOX=true

# Resend (email)
RESEND_API_KEY=""
EMAIL_FROM="sklep@twojadomena.pl"

# Supabase Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# AdminJS
ADMIN_COOKIE_SECRET="change-me-admin-cookie-secret"
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="change-me-admin-password"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:4200"

# Sentry (optional — leave empty to disable error monitoring)
SENTRY_DSN=""
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Frontend ──────────────────────────────────────────────────────────────────
# Copy to frontend/.env

API_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""

# Sentry (frontend) — set in frontend/src/environments/environment.*.ts
# SENTRY_DSN_FRONTEND=""
