# Supabase pooler (port 6543). connection_limit caps Prisma's per-instance pool
# so we don't exhaust the shared pgbouncer transaction pool under load.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
# Direct connection (port 5432) — used by `prisma migrate` only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

P24_MERCHANT_ID=""
P24_POS_ID=""
P24_CRC=""
P24_API_KEY=""
P24_SANDBOX=true
P24_NOTIFY_URL="http://localhost:3000/payments/webhook"
P24_RETURN_URL="http://localhost:4200/checkout/success"
P24_CANCEL_URL="http://localhost:4200/checkout/failure"

INPOST_API_TOKEN=""
INPOST_ORGANIZATION_ID=""
INPOST_SANDBOX=true

DHL_API_KEY=""
DHL_API_SECRET=""
DHL_ACCOUNT_NUMBER=""
DHL_SANDBOX=true

GLS_USERNAME=""
GLS_PASSWORD=""
GLS_SENDER_ID=""
GLS_SANDBOX=true

RESEND_API_KEY=""
EMAIL_FROM="sklep@twojadomena.pl"

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# Seller info for Polish VAT invoices (required in production)
# SELLER_NIP must be 10 digits, no spaces or dashes
SELLER_NAME="Aromaterie Sp. z o.o."
SELLER_NIP=""
SELLER_STREET=""
SELLER_CITY=""
SELLER_POSTAL_CODE=""

ADMIN_COOKIE_SECRET="change-me-admin-cookie-secret"
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="change-me-admin-password"

PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:4200"
