# Supabase pooler (port 6543, pgbouncer transaction mode).
# connection_limit is injected at runtime from DATABASE_CONNECTION_LIMIT —
# you don't need to set it in this URL (PrismaService overwrites it).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&pool_timeout=20"
# Direct connection (port 5432) — used by `prisma migrate` only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Prisma connections per backend instance.
# Formula: DATABASE_CONNECTION_LIMIT × Railway replicas ≤ Supabase max_client_conn
# Supabase free tier: 60 total  → 10 limit → safe for up to 6 replicas
# Supabase Pro tier: 200 total  → 10 limit → safe for up to 20 replicas
DATABASE_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_test_ / pk_test_ for development; sk_live_ / pk_live_ for production.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Run `stripe listen --forward-to localhost:3000/payments/webhook` for local dev.
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="pln"
STRIPE_SUCCESS_URL="http://localhost:4200/checkout/success"
STRIPE_CANCEL_URL="http://localhost:4200/checkout/failure"
# Checkout session TTL in minutes. Stripe minimum is 30. Controls how long
# stock is locked for an unpaid order before the session expires and stock
# is automatically restored via the checkout.session.expired webhook.
STRIPE_CHECKOUT_TTL_MINUTES=30
# Secret for POST /payments/reconcile — called by an external cron to wake
# the reconciliation job on Railway hobby tier (containers sleep on inactivity
# and @Cron does not fire while sleeping). Use a strong random string (≥32 chars).
# Required in production. See CLAUDE.md → Railway → Reconciliation cron.
PAYMENTS_RECONCILE_SECRET=""

# ── InPost ShipX ──────────────────────────────────────────────────────────────
# Set INPOST_MOCK_ENABLED=true to skip real API calls during local development.
# Switch to false + real credentials when you have a sandbox/production account.
INPOST_MOCK_ENABLED=true
INPOST_ORGANIZATION_ID=""
INPOST_API_TOKEN=""

# ── DHL (set DHL_MOCK_ENABLED=true to skip real API calls) ───────────────────
DHL_MOCK_ENABLED=true
DHL_API_KEY=""
DHL_API_SECRET=""
DHL_ACCOUNT_NUMBER=""
# DHL_SANDBOX=true   # uncomment to use DHL sandbox endpoint

# ── GLS (set GLS_MOCK_ENABLED=true to skip real API calls) ───────────────────
GLS_MOCK_ENABLED=true
GLS_USERNAME=""
GLS_PASSWORD=""
GLS_SENDER_ID=""

# ── DPD Polska (set DPD_MOCK_ENABLED=true to skip real API calls) ─────────────
DPD_MOCK_ENABLED=true
DPD_API_KEY=""
DPD_SENDER_ID=""

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
# Signing secret from Resend Dashboard → Webhooks → your endpoint → "Signing Secret"
RESEND_WEBHOOK_SECRET=""

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Seller info (for Polish VAT invoices — required in production) ────────────
# SELLER_NIP must be 10 digits, no spaces or dashes.
SELLER_NAME="Aromaterie"
SELLER_NIP=""
SELLER_STREET=""
SELLER_CITY=""
SELLER_POSTAL_CODE=""

# ── Admin panel ───────────────────────────────────────────────────────────────
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="change-me-admin-password"
ADMIN_SESSION_SECRET="change-me-admin-session-secret"
# Optional: email address to receive new-order merchant alerts (defaults to EMAIL_FROM).
ADMIN_ALERT_EMAIL=""
# Optional: Slack incoming webhook URL for instant new-order push notifications.
# Create at https://api.slack.com/apps → Incoming Webhooks → Add to Workspace.
MERCHANT_SLACK_WEBHOOK_URL=""

# ── Sentry (optional — SDK is a no-op when SENTRY_DSN is empty) ──────────────
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
# Required in production. Without a real Redis service, BullMQ will connect to
# localhost (which does not exist on Railway) and silently never process jobs —
# every transactional email (order confirmation, invoice, payment failure) will
# queue but never send. Provision a Railway Redis service and copy its URL here.
REDIS_URL="redis://localhost:6379"

PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:4200"