generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  FRAUD_REVIEW
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTE_HOLD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  LABEL_PENDING
  LABEL_GENERATED
  LABEL_ERROR
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum CarrierCode {
  INPOST
  DHL
  GLS
  DPD
  DPD_COURIER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CouponType {
  WELCOME
  BIRTHDAY
  CART_ABANDONMENT
  LOYALTY
  WIN_BACK
  SUBSCRIPTION
  CUSTOM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnType {
  WITHDRAWAL
  COMPLAINT
}

enum ReturnStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum EmailTokenType {
  EMAIL_VERIFICATION
  MAGIC_LINK
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?
  role            Role     @default(CUSTOMER)
  firstName       String?
  lastName        String?
  phone           String?
  googleId        String?  @unique
  nip             String?
  isEmailVerified   Boolean   @default(false)
  pendingEmail      String?
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  analyticsConsent   Boolean   @default(false)
  analyticsConsentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  addresses               Address[]
  orders                  Order[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  carts                   Cart[]
  wishlistItems           WishlistItem[]
  reviews                 Review[]
  reviewHelpfulVotes      ReviewHelpfulVote[]
  customerNotes           CustomerNote[]

  @@map("users")
}

model CustomerNote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  adminEmail String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("customer_notes")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  family     String    @default(uuid())
  replacedBy String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([family])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String         @id @default(uuid())
  tokenHash String         @unique
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  type      EmailTokenType @default(EMAIL_VERIFICATION)
  createdAt DateTime       @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault  Boolean  @default(false)
  firstName  String
  lastName   String
  company    String?
  street     String
  city       String
  postalCode String
  country    String   @default("PL")
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@map("addresses")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model LuxuryReference {
  id       Int       @id @default(autoincrement())
  brand    String    @default("")
  name     String
  aliases  String[]

  products Product[]

  @@unique([brand, name])
  @@index([brand])
  @@map("luxury_references")
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  shortDescription String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  brand            String?
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  scentFamily      String?
  notes            String[]
  pyramidTop       String?
  pyramidHeart     String?
  pyramidBase      String?
  gender           String?
  catalogNumber    String?
  line             String?
  inspiredBy          String?
  luxuryReferenceId   Int?
  luxuryReference     LuxuryReference? @relation(fields: [luxuryReferenceId], references: [id], onDelete: SetNull)
  sortOrder        Int      @default(0)

  // EU Cosmetics Regulation 1223/2009 — mandatory for distance selling
  ingredients      String?   // full INCI string as printed on the data sheet
  allergens        String[]  // allergens listed individually above threshold (>0.001% for leave-on)
  paoMonths        Int?      // Period After Opening in months (PAO symbol)
  warnings         String?   // safety warnings (Ostrzeżenia) from data sheet

  // REACH Regulation 2020/878 — SDS mandatory for hazardous products (diffusers)
  sdsUrl           String?   // Supabase public URL to Safety Data Sheet PDF

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewCount  Int     @default(0)
  avgRating    Float?

  variants      ProductVariant[]
  images        ProductImage[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  @@map("products")
}

model ProductVariant {
  id                   String   @id @default(uuid())
  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                  String   @unique
  volume               Int?
  weight               Int?
  label                String
  priceInCents         Int
  compareAtPriceInCents Int?
  vatRate              Int      @default(2300)
  stock                Int      @default(0)
  reorderThreshold     Int      @default(5)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orderItems    OrderItem[]
  cartItems     CartItem[]
  priceHistory  ProductVariantPriceHistory[]

  @@map("product_variants")
}

// EU Omnibus Directive (2019/2161) — when a promotional price is displayed
// alongside a strikethrough compareAtPriceInCents, Polish law requires showing
// the lowest price charged in the preceding 30 days. This table is the
// append-only log that makes that calculation possible.
model ProductVariantPriceHistory {
  id           String         @id @default(uuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceInCents Int
  recordedAt   DateTime       @default(now())

  @@index([variantId, recordedAt])
  @@map("product_variant_price_history")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  storagePath String
  altText     String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([sessionId])
  @@index([userId])
  @@map("carts")
}

model CartItem {
  id               String         @id @default(uuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  quantity         Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@map("cart_items")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status             OrderStatus @default(PENDING_PAYMENT)
  addressId          String?
  shippingAddress    Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)

  snapshotFirstName  String
  snapshotLastName   String
  snapshotCompany    String?
  snapshotStreet     String
  snapshotCity       String
  snapshotPostalCode String
  snapshotCountry    String
  snapshotPhone      String
  snapshotEmail      String
  snapshotNip        String?

  itemsTotalInCents   Int
  shippingCostInCents Int
  discountInCents     Int         @default(0)
  totalInCents        Int

  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?

  carrierCode         CarrierCode
  inpostLockerCode    String?
  dpdPickupPointCode  String?
  notes               String?

  termsVersion    String?
  termsAcceptedAt DateTime?

  invoiceUrl          String?
  invoiceStoragePath  String?
  invoiceNumber       String? @unique
  isRead        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  payment        Payment?
  shipment       Shipment?
  events         OrderEvent[]
  couponUse      CouponUse?
  reviews        Review[]
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  snapshotName      String
  snapshotSku       String
  snapshotPrice     Int
  snapshotVatRate   Int @default(2300)
  quantity          Int
  cancelledQuantity Int @default(0)

  @@index([orderId])
  @@map("order_items")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id                       String        @id @default(uuid())
  orderId                  String        @unique
  order                    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status                   PaymentStatus @default(PENDING)
  provider                 String        @default("stripe")
  stripeCheckoutSessionId  String?       @unique
  stripePaymentIntentId    String?       @unique
  amountInCents            Int
  refundedAmountInCents    Int           @default(0)
  currency                 String        @default("PLN")
  paidAt                   DateTime?
  failureReason            String?
  rawWebhookPayload        Json?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@map("payments")
}

// ─── Shipping ────────────────────────────────────────────────────────────────

model Shipment {
  id               String         @id @default(uuid())
  orderId          String         @unique
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           ShipmentStatus @default(LABEL_PENDING)
  carrierCode      CarrierCode
  trackingNumber   String?
  labelUrl         String?
  waybillNumber    String?
  shipmentId       String?
  targetLockerCode String?
  dispatchNumber   String?
  labelGeneratedAt DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  estimatedDelivery DateTime?
  rawCarrierResponse Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("shipments")
}

// ─── Order Events (Audit Trail) ──────────────────────────────────────────────

model OrderEvent {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      String
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
  @@map("order_events")
}

// ─── Wishlist ────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifyOnRestock Boolean  @default(false)
  addedAt         DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ─── Coupons ─────────────────────────────────────────────────────────────────

model Coupon {
  id                 String       @id @default(uuid())
  code               String       @unique
  discountType       DiscountType
  value              Int
  couponType         CouponType   @default(CUSTOM)
  minSpendInCents    Int?
  maxUsesTotal       Int?
  maxUsesPerUser     Int?
  currentUses        Int          @default(0)
  isActive           Boolean      @default(true)
  timezone           String       @default("Europe/Warsaw")
  startsAt           DateTime?
  expiresAt          DateTime?
  excludedProductIds String[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  uses   CouponUse[]
  orders Order[]

  @@map("coupons")
}

model CouponUse {
  id                     String   @id @default(uuid())
  couponId               String
  coupon                 Coupon   @relation(fields: [couponId], references: [id])
  orderId                String   @unique
  order                  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId                 String?
  discountAppliedInCents Int
  createdAt              DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_uses")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id           String       @id @default(uuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating       Int
  title        String?
  body         String?
  status       ReviewStatus @default(PENDING)
  adminReply   String?
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  helpfulVotes ReviewHelpfulVote[]

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([userId])
  @@map("reviews")
}

model ReviewHelpfulVote {
  reviewId  String
  userId    String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([reviewId, userId])
  @@map("review_helpful_votes")
}

// ─── Returns ─────────────────────────────────────────────────────────────────

model ReturnRequest {
  id                  String       @id @default(cuid())
  orderId             String?
  order               Order?       @relation(fields: [orderId], references: [id])
  orderNumber         String
  email               String
  firstName           String
  lastName            String
  phone               String?
  type                ReturnType   @default(WITHDRAWAL)
  deliveryDate        DateTime?
  items               Json
  reason              String?
  requestedResolution String?
  bankAccount         String?
  sealedOnReturn        Boolean?
  returnTrackingNumber  String?      @map("return_tracking_number")
  status                ReturnStatus @default(PENDING)
  adminNote             String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([orderId])
  @@index([email])
  @@index([orderNumber])
  @@map("return_requests")
}

// ─── Stripe Event Deduplication ──────────────────────────────────────────────
// Stores processed Stripe event IDs so duplicate webhook deliveries (Stripe
// retries for up to 3 days) are silently skipped. The @id gives a unique
// constraint — a second insert for the same event_id throws P2002 and is
// caught in handleWebhookEvent. The createdAt index supports periodic cleanup.

model ProcessedStripeEvent {
  eventId   String   @id @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("processed_stripe_events")
}

// ─── Admin Audit Log ─────────────────────────────────────────────────────────

model AdminLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  actor      String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actor])
  @@index([createdAt])
  @@map("admin_logs")
}

// ─── Email Logs ───────────────────────────────────────────────────────────────

model EmailLog {
  id            String   @id @default(uuid())
  resendEmailId String
  event         String
  to            String
  subject       String?
  payload       Json
  createdAt     DateTime @default(now())

  @@index([resendEmailId])
  @@index([event])
  @@index([to])
  @@map("email_logs")
}

// ─── Shipping Rates ───────────────────────────────────────────────────────────
// One row per carrier. Editable via admin without a deploy.
// priceInCents is the source of truth; orders.service reads from here.
// Seeded by the migration that creates this table.

model ShippingRate {
  carrierCode  CarrierCode @id @map("carrier_code")
  priceInCents Int         @map("price_in_cents")
  isActive     Boolean     @default(true) @map("is_active")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("shipping_rates")
}

model ConsentLog {
  id           String   @id @default(uuid())
  sessionHash  String   @map("session_hash")
  analytics    Boolean
  consentedAt  DateTime @default(now()) @map("consented_at")

  @@map("consent_logs")
}
