{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "prebuild": "node scripts/inject-sentry-dsn.mjs && node scripts/generate-sitemap.mjs",
    "build": "ng build --configuration production",
    "postbuild": "node scripts/upload-sourcemaps.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@angular/animations": "^20.3.23",
    "@angular/build": "^20.3.23",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.23",
    "@angular/compiler": "^20.3.23",
    "@angular/core": "^20.3.23",
    "@angular/forms": "^20.3.23",
    "@angular/platform-browser": "^20.3.23",
    "@angular/platform-browser-dynamic": "^20.3.23",
    "@angular/platform-server": "^20.3.23",
    "@angular/router": "^20.3.23",
    "@angular/service-worker": "^20.3.23",
    "@angular/ssr": "^20.3.23",
    "@fragrance-store/shared-types": "workspace:*",
    "@ng-web-apis/common": "^4.14.0",
    "@sentry/angular": "^10.48.0",
    "@taiga-ui/cdk": "^4.78.1",
    "@taiga-ui/core": "^4.78.1",
    "@taiga-ui/event-plugins": "^4.7.0",
    "@taiga-ui/experimental": "^4.78.0",
    "@taiga-ui/i18n": "^4.80.1",
    "@taiga-ui/icons": "^4.78.1",
    "@taiga-ui/kit": "^4.78.1",
    "@taiga-ui/layout": "^4.78.1",
    "@taiga-ui/polymorpheus": "^4.9.0",
    "express": "^4.18.2",
    "libphonenumber-js": "^1.12.42",
    "rxjs": "~7.8.0",
    "tslib": "^2.7.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@sentry/cli": "^2.42.2",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/cli": "^20.3.23",
    "@angular/compiler-cli": "^20.3.23",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^16.1.4",
    "typescript": "~5.9.3"
