{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @fragrance-store/shared-types build && pnpm --filter frontend build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "frontend/dist/frontend/browser",
  "framework": null,
  "trailingSlash": false,
  "functions": {
    "api/ssr.mjs": {
      "includeFiles": "frontend/dist/frontend/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/ssr"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.js|.*\\.css|.*\\.woff2?|.*\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
