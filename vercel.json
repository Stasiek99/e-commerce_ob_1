{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter frontend build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "frontend/dist/frontend/browser",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!assets/|favicon.ico|sitemap.xml|.*\\.(?:js|css|map|ico|png|jpg|jpeg|svg|webp|woff2?|ttf|txt|xml)$).*)",
      "destination": "/frontend/dist/frontend/browser/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(?:js|css|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}